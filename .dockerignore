# Contexte de build minimal : manifestes + src/ + membres du workspace
# (forge, ccos, crates) sont copiés par le Dockerfile ; on exclut tout le
# reste pour garder le contexte léger et le build reproductible.
/target
/.git
/.env
/docs
/paper
/examples
/tests
/scripts
*.md
*.sled
forge_checkpoint.json
rsi_full_trajectory.*
**/*.rs.bk
